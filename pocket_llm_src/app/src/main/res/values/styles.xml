<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minWidth">92dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="elevation">0dp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="SendButton" parent="ActionButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">?attr/colorSendFill</item>
        <item name="rippleColor">?attr/colorSendStroke</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="StopButton" parent="ActionButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">?attr/colorStopFill</item>
        <item name="rippleColor">?attr/colorStopStroke</item>
        <item name="android:textColor">@color/on_stop</item>
    </style>

    <style name="InputToolButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">7dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">?attr/colorFrameBackground</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">?attr/colorSendStroke</item>
        <item name="iconTint">?attr/colorStatusText</item>
        <item name="android:textColor">?attr/colorAssistantText</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DialogPrimaryButton" parent="SendButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="DialogSecondaryButton" parent="ActionButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">?attr/colorPocketRaised</item>
        <item name="strokeColor">?attr/colorPocketOutline</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">?attr/colorSendStroke</item>
        <item name="android:textColor">?attr/colorAssistantText</item>
    </style>

    <style name="ModelItemActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="backgroundTint">?attr/colorSendFill</item>
        <item name="strokeColor">?attr/colorSendFill</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="ClearButton">
        <item name="android:background">@drawable/btn_clear</item>
        <item name="android:textColor">#FFFF00</item>
        <item name="android:padding">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AppDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="backgroundTint">?attr/colorFrameBackground</item>
    </style>

    <style name="AppSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:thumbTint">?attr/colorSendFill</item>
        <item name="android:progressTint">?attr/colorSendFill</item>
        <item name="android:secondaryProgressTint">?attr/colorSendStroke</item>
        <item name="android:progressBackgroundTint">?attr/colorSendStroke</item>
        <item name="android:splitTrack">false</item>
    </style>

    <style name="DangerSoftButton" parent="ActionButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/stop_soft_fill</item>
        <item name="rippleColor">@color/stop_button_fill</item>
        <item name="android:textColor">@color/stop_button_fill</item>
    </style>

    <style name="ShapeAppearance.Pocket.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ThemeOverlay.Pocket.AlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">?attr/colorAppBackground</item>
        <item name="colorPrimary">?attr/colorSendFill</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Pocket.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Pocket.AlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Pocket.AlertDialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Pocket.AlertDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Pocket.AlertDialog.Button.Muted</item>
        <item name="buttonBarNeutralButtonStyle">@style/Pocket.AlertDialog.Button.Muted</item>
    </style>

    <style name="Pocket.AlertDialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">?attr/colorSendFill</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Pocket.AlertDialog.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">?attr/colorStatusText</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Pocket.AlertDialog.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">?attr/colorSendFill</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="Pocket.AlertDialog.Button.Muted" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorStatusText</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Pocket.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

    <style name="Pocket.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">34dp</item>
        <item name="chipCornerRadius">17dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">13.5sp</item>
        <item name="rippleColor">?attr/colorUserBubble</item>
    </style>
</resources>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 themes. One layout, three seeds (Cobalt default, Emerald, Coral), light and dark each.
         Role values come from docs/dev/ui-redesign/m3-concept.html. Base = Cobalt dark. -->

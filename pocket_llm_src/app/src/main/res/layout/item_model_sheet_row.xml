<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the model sheet: icon tile, name and detail, trailing check / action text / chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_model_tile">

        <TextView
            android:id="@+id/modelRowInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/space_grotesk_semibold"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/modelRowIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/modelRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/modelRowDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/modelRowAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/modelRowTrailing"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>

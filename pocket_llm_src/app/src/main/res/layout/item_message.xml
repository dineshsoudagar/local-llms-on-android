<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/messageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="5dp">

    <LinearLayout
        android:id="@+id/preResponseStatusContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.example.local_llm.NodeOrbView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/preResponseStatusView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:textColor="?attr/colorStatusText"
            android:textSize="14sp"
            android:textStyle="normal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/thoughtContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/thoughtHeaderView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:textColor="?attr/colorStatusText"
            android:textSize="14sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/thoughtView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="12dp"
            android:textColor="?attr/colorStatusText"
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/messageBubbleFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/messageImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_bubble_user"
            android:clipToOutline="true"
            android:contentDescription="@string/chat_image_attachment"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_bot"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="?attr/colorAssistantText"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/copyResponseButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/copy_response"
            android:padding="5dp"
            android:src="@drawable/ic_copy_20"
            app:tint="?attr/colorStatusText"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/reportResponseButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/report_response"
            android:padding="5dp"
            android:src="@drawable/ic_flag_20"
            app:tint="?attr/colorStatusText"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/replyActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/replyCopy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/copy_response"
            android:padding="7dp"
            android:src="@drawable/ic_copy_20"
            app:tint="?attr/colorStatusText" />

        <ImageButton
            android:id="@+id/replyTranslate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reply_translate"
            android:padding="7dp"
            android:src="@drawable/ic_translate_24"
            app:tint="?attr/colorStatusText" />

        <ImageButton
            android:id="@+id/replyShare"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reply_share"
            android:padding="7dp"
            android:src="@drawable/ic_reply_share_20"
            app:tint="?attr/colorStatusText" />

        <ImageButton
            android:id="@+id/replyRetry"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reply_retry"
            android:padding="7dp"
            android:src="@drawable/ic_reply_refresh_20"
            app:tint="?attr/colorStatusText" />

        <ImageButton
            android:id="@+id/replyReport"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/report_response"
            android:padding="7dp"
            android:src="@drawable/ic_flag_20"
            app:tint="?attr/colorStatusText" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/magicActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/magicCutout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/magic_cutout"
                android:letterSpacing="0"
                android:textAllCaps="false"
                android:textColor="?attr/colorAssistantText"
                android:textSize="13sp"
                app:backgroundTint="?attr/colorFrameBackground"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_cutout_20"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/pro_gold_dark"
                app:rippleColor="@android:color/transparent"
                app:strokeColor="@color/pro_gold"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/magicRestyle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/magic_restyle"
                android:letterSpacing="0"
                android:textAllCaps="false"
                android:textColor="?attr/colorAssistantText"
                android:textSize="13sp"
                app:backgroundTint="?attr/colorFrameBackground"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_edit_20"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/pro_gold_dark"
                app:rippleColor="@android:color/transparent"
                app:strokeColor="@color/pro_gold"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/magicProChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pro_gold"
                android:paddingHorizontal="7dp"
                android:paddingVertical="1dp"
                android:text="@string/pro_chip"
                android:textColor="@color/pro_on_gold"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/magicNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorStatusText"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/messageSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="8dp"
        android:textColor="@color/pocket_faint"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>

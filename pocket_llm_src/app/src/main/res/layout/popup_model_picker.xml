<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_model_picker_panel"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <ScrollView
        android:id="@+id/modelPickerScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/modelPickerOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:alpha="0.16"
        android:background="?attr/colorStatusText" />

    <TextView
        android:id="@+id/modelPickerManageLink"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="8dp"
        android:text="@string/model_popup_manage_link"
        android:textColor="?attr/colorSendFill"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>

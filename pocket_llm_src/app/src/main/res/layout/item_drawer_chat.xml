<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <View
        android:id="@+id/drawerSessionDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorPocketOutline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <TextView
            android:id="@+id/drawerSessionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorAssistantText"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/drawerSessionTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?attr/colorStatusText"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/drawerSessionMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/chat_menu"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_more_vert_20"
            app:tint="?attr/colorStatusText" />
    </LinearLayout>
</LinearLayout>

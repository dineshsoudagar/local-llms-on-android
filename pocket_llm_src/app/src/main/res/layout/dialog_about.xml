<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:alpha="0.88"
        android:background="@drawable/bg_logo_tile"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerInside"
        android:src="@drawable/logo_about" />

    <TextView
        android:id="@+id/aboutAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/toolbar_app_title"
        android:textColor="?attr/colorAssistantText"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aboutVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorStatusText"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/aboutGithubLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:autoLink="web"
        android:gravity="center"
        android:linksClickable="true"
        android:padding="14dp"
        android:text="@string/about_github_link"
        android:textColor="?attr/colorAssistantText"
        android:textColorLink="?attr/colorSendFill"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/aboutOkButton"
        style="@style/DialogPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="@android:string/ok" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lanServerDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lan_server_title"
            android:textColor="?attr/colorAssistantText"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/lanServerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="?attr/colorStatusText"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Stopped" />

    <TextView
        android:id="@+id/lanServerEndpointLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lan_server_endpoint_label"
        android:textColor="?attr/colorAssistantText"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lanServerEndpoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorInputText"
        android:textIsSelectable="true"
        android:textSize="14sp"
        tools:text="http://192.168.1.20:8080" />

    <TextView
        android:id="@+id/lanServerApiEndpointLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/lan_server_api_endpoint_label"
        android:textColor="?attr/colorAssistantText"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lanServerApiEndpoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/colorInputText"
        android:textIsSelectable="true"
        android:textSize="14sp"
        tools:text="http://192.168.1.20:8080/v1" />

    <TextView
        android:id="@+id/lanServerCopyApiUrlLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="6dp"
        android:text="@string/lan_server_copy_api_url"
        android:textColor="?attr/colorSendFill"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lanServerPasswordLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/lan_server_password_label"
        android:textColor="?attr/colorAssistantText"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/lanServerPasswordInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="password"
            android:hint="@string/lan_server_password_hint"
            android:inputType="textVisiblePassword"
            android:maxLines="1"
            android:textColor="?attr/colorInputText"
            android:textColorHint="?attr/colorStatusText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lanServerGeneratePasswordButton"
            style="@style/DialogSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/lan_server_generate_password" />
    </LinearLayout>

    <TextView
        android:id="@+id/lanServerPasswordHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/lan_server_password_help"
        android:textColor="?attr/colorStatusText"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/lanServerInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/lan_server_instructions"
        android:textColor="?attr/colorStatusText"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/lanServerWebActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lanServerCopyUrlLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/lan_server_copy_url"
            android:textColor="?attr/colorSendFill"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lanServerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lanServerStartButton"
            style="@style/DialogPrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lan_server_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lanServerCloseButton"
            style="@style/DialogSecondaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:contentDescription="@string/lan_server_stop_close_description"
            android:text="@string/close" />
    </LinearLayout>

</LinearLayout>

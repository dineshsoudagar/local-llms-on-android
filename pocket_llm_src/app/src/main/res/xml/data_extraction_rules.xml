<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="chat_attachments/" />
        <!-- Downloaded models and speech files are large and can be downloaded again. -->
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="asr/" />
        <!-- The Pro unlock is restored from Google Play, never from a backup. -->
        <exclude domain="sharedpref" path="pocket_pro.xml" />
        <!-- Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="chat_attachments/" />
        <!-- Downloaded models and speech files are large and can be downloaded again. -->
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="asr/" />
        <!-- The Pro unlock is restored from Google Play, never from a backup. -->
        <exclude domain="sharedpref" path="pocket_pro.xml" />
    </device-transfer>
</data-extraction-rules>

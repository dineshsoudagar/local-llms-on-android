<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="file" path="chat_attachments/" />
    <!-- Downloaded models and speech files are large and can be downloaded again. -->
    <exclude domain="file" path="models/" />
    <exclude domain="file" path="asr/" />
    <!-- The Pro unlock is restored from Google Play, never from a backup. -->
    <exclude domain="sharedpref" path="pocket_pro.xml" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>

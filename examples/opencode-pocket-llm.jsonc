{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "pocket-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Pocket LLM (Android)",
      "options": {
        "baseURL": "http://PHONE_IP:8080/v1",
        "apiKey": "{env:POCKET_LLM_PASSWORD}"
      },
      "models": {
        "qwen3_litert": {
          "name": "Qwen3 0.6B LiteRT",
          "limit": {
            // Leave room for OpenCode's system prompt and tool definitions on mobile.
            // Match this with the selected model's context setting in the Android app.
            "context": 8192,
            "output": 512
          }
        }
      }
    }
  },
  "model": "pocket-llm/qwen3_litert"
}
